VITE_API_BASE_URL=http://localhost:5000/api
# Origin-only (no path) — used solely for the CSP connect-src in index.html.
# CSP path-based source matching requires an exact match unless the path
# ends in "/", so this is kept separate from VITE_API_BASE_URL above rather
# than relying on path-prefix semantics.
VITE_API_ORIGIN=http://localhost:5000
